# ---------------------------------------------------------------------------
# Keybox environment configuration
# Copy to `.env` and fill in real values. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the server listens on
PORT=3000

# MongoDB connection string (legacy alias MONGODB_URI is still accepted)
DATABASE_URL=mongodb://127.0.0.1:27017/keybox

# Secret used ONLY to sign/verify authentication JWTs.
# MUST be different from KEYBOX_ENCRYPTION_KEY.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# AES-256 key used ONLY to encrypt/decrypt stored API keys.
# MUST be a 32-byte key, encoded as base64 (recommended) or hex (64 chars).
# MUST be different from JWT_SECRET. NEVER expose this via any API.
# Generate with: openssl rand -base64 32
KEYBOX_ENCRYPTION_KEY=

# Comma-separated list of allowed CORS origins (no wildcards in production).
# Example: https://vault.josh.dev,https://app.josh.dev
CORS_ORIGIN=http://localhost:5173
